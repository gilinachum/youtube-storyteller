# StoryTeller — Environment Configuration
# Copy to .env and fill in your values
# .env is gitignored and never committed

# ── AWS ──────────────────────────────────────────────────────────────────────
CDK_DEFAULT_ACCOUNT=123456789012
CDK_DEFAULT_REGION=us-east-1

# ── Frontend (Vite build vars) ───────────────────────────────────────────────
VITE_API_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXX
VITE_COGNITO_CLIENT_ID=your-cognito-app-client-id

# ── Deploy scripts ───────────────────────────────────────────────────────────
FRONTEND_S3_BUCKET=your-frontend-s3-bucket-name
CF_DISTRIBUTION_ID=E1234567890ABC

# ── Agent deploy ─────────────────────────────────────────────────────────────
AGENT_RUNTIME_ID=your-agentcore-runtime-id
EXECUTION_ROLE=arn:aws:iam::123456789012:role/AmazonBedrockAgentCoreSDKRuntime-REGION-XXXXXXXXXX
COGNITO_DISCOVERY_URL=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXX/.well-known/openid-configuration
COGNITO_AUDIENCE=your-cognito-app-client-id
MESSAGES_TABLE=storyteller-messages
SESSIONS_TABLE=storyteller-sessions
UPLOAD_BUCKET=your-upload-bucket-name
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_REGION=us-east-1

# ── Web Search Gateway (infra/stacks/gateway_search_stack.py) ───────────────
# Required — no hardcoded fallback in infra/app.py. That stack deploys once
# and grants BOTH stages' AgentCore runtime roles invoke access on the
# shared Gateway, regardless of which stage is currently being deployed, so
# both ARNs must be set in .env.dev AND .env.prod (keep them identical in
# both files).
STORYTELLER_DEV_RUNTIME_ROLE_ARN=arn:aws:iam::123456789012:role/AmazonBedrockAgentCoreSDKRuntime-us-west-2-XXXXXXXXXX
STORYTELLER_PROD_RUNTIME_ROLE_ARN=arn:aws:iam::123456789012:role/AmazonBedrockAgentCoreSDKRuntime-us-east-1-XXXXXXXXXX

# ── Agent Model Configuration ────────────────────────────────────────────────
# Switch between model providers:
#   bedrock  = Converse API (Claude, Nova, etc.) — default
#   mantle   = OpenAI-compatible API on bedrock-mantle endpoint (Grok, GPT-OSS, etc.)
AGENT_MODEL_PROVIDER=bedrock
# Model ID (defaults to BEDROCK_MODEL_ID for bedrock provider, xai.grok-4.3 for mantle)
AGENT_MODEL_ID=us.anthropic.claude-sonnet-4-6
# To use Grok 4.3:
#   AGENT_MODEL_PROVIDER=mantle
#   AGENT_MODEL_ID=xai.grok-4.3

# ── CDK context (alternative to env vars) ────────────────────────────────────
# Pass via: cdk deploy -c frontendUrl=https://your-domain.cloudfront.net
# FRONTEND_URL=https://your-domain.cloudfront.net

# ── E2E tests ────────────────────────────────────────────────────────────────
# APP_URL=https://your-domain.cloudfront.net
# TEST_EMAIL=test@example.com
# TEST_PASSWORD=your-test-password
