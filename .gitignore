# Dependencies
node_modules/
.venv/
__pycache__/
*.pyc
*.pyo

# Build artifacts
dist/
frontend/dist/
*.zip
cdk.out/
infra/cdk.out/

# Environment & secrets
.env
.env.*
!.env.example
*.pem

# AgentCore local config (contains account-specific ARNs)
.bedrock_agentcore.yaml
.bedrock_agentcore/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Python
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Logs
*.log

# Lambda layer build artifacts (rebuilt by deploy scripts)
infra/layers/*/python/
infra/layers/*/nodejs/

# Private overlay (if cloned in as private/ or .amazon-internal/)
.amazon-internal/
private/

# Amazon-internal setup script + state (secrets, ARNs, account IDs)
infra-private/

# CDK deploy output (contains account-specific ARNs, bucket names, API IDs,
# CloudFront domains — regenerated by scripts/deploy.sh on every deploy)
cdk-outputs-*.json

# Auth-related files dropped in by the private overlay
api/federate_authorizer.py
api/auth_callback.py
frontend/public/error/403.html
frontend/public/js/cfs-handler.js
infra/layers/federate-auth/
.env.dev
test-results/
evaluations/
